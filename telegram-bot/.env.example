TELEGRAM_BOT_TOKEN=your_bot_token_here
# Optional: restrict bot to your Telegram user ID (get it from @userinfobot or /id)
ALLOWED_USER_ID=
# Optional: restrict bot to a specific group/chat ID (get it via /id in the group)
ALLOWED_CHAT_ID=
# Inactivity timeout in seconds before auto-stopping the VM (default: 300 = 5 mins)
INACTIVITY_TIMEOUT=300
# Optional: BoxCompute sandbox ID for clean stop via `bxc sandbox stop`
BOXCOMPUTE_SANDBOX_ID=
